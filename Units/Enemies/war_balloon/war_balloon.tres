[resource]
script = ExtResource("1_data")
title = "The War Balloon"
icon = ExtResource("2_icon")
description = "A slow siege balloon that crushes blocked towers with a two-cell blast. At the start of every subwave, it drops a squad of 30 warriors."
indexable = false
stat_displays = Array[ExtResource("3_display")]([ExtResource("4_health"), ExtResource("5_speed"), ExtResource("6_damage"), ExtResource("7_hitrate"), ExtResource("8_range")])
important = true
unit_scene = ExtResource("9_scene")
flux_value = 4.0
strength_value = 8.0
